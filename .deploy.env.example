# 终极版邮箱部署配置（aevorynthtech.com）
# 用法：cp .deploy.env.example .deploy.env，填好真实值后跑 ./deploy.sh。
# 本文件已加入 .gitignore，绝不提交进 Git；jwt_secret 必须重新生成，绝不复用老站。

# D1 数据库 mail-ultimate 的 database_id（wrangler d1 create 后取）
D1_DATABASE_ID=
# KV 命名空间 mail-ultimate-kv 的 id
KV_NAMESPACE_ID=
# R2 存储桶名
R2_BUCKET_NAME=mail-ultimate
# 管理员邮箱（建议新建一个 @aevorynthtech.com 管理员账号）
ADMIN=
# JWT_SECRET：openssl rand -hex 32 现场生成，长度 ≥32；同时也是 /init 的调用密钥
JWT_SECRET=
# FIELD_ENC_KEY：敏感字段应用层加密密钥（AES-GCM，Phase 6）。openssl rand -hex 32 现场生成，与 JWT_SECRET 不同、绝不复用；部署时以 wrangler secret 形式配置，不写进代码仓库
FIELD_ENC_KEY=
# GitHub 仓库（可选，格式：用户名/仓库名；用户自己上传后再填，不填不影响部署）
GH_REPO=
